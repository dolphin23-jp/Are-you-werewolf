# --- Secrets ---
# APIキー等は絶対にコミットしない。パスにスラッシュを含めないことで
# リポジトリ内のどの階層の .env / .env.local / .env.production 等も
# まとめて無視する。プレースホルダーの .env.example のみ追跡する。
.env
.env.*
!.env.example
!.env.*.example
secrets.json
*.pem
*.key

# --- Python / backend ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
*.tsbuildinfo

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- Logs ---
*.log
