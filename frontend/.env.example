# Leave these unset for the normal setup: the app talks to the page's own
# origin, which `pnpm dev` proxies to the backend (vite.config.ts) and FastAPI
# serves directly after `pnpm build`. Setting them bakes the URLs into the
# build, and ws:// breaks behind HTTPS (e.g. Codespaces).
# Only for a frontend and backend deployed on genuinely separate hosts:
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_BASE_URL=wss://api.example.com
