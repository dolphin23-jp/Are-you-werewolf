# Template only -- copy to `backend/.env` and fill in real values there.
# `.env` is gitignored; THIS file is committed to a PUBLIC repository, so
# never put a real API key in it.
#
# --- LLM Provider (gpt-6-luna via OpenAI-compatible API) ---
# NOTE: LUNA_* names/values are placeholders pending the real gpt-6-luna
# endpoint details (base URL / auth scheme). Rename freely once known.
WEREWOLF_LLM_PROVIDER=mock          # mock | scenario | luna
# mock     : 9つの定型文を返す最小のテストダブル(既定・オフライン・費用ゼロ)
# scenario : 返信/引用・名指し質問・論点・処刑候補まで構造を埋めるテストダブル
#            (オフライン・費用ゼロ。指標を縮退させずに前後比較したいときに使う)
# luna     : 実際の gpt-6-luna(要 LUNA_API_KEY / 課金あり)
LUNA_API_KEY=
LUNA_BASE_URL=https://api.example.com/v1
LUNA_MODEL=gpt-6-luna
LUNA_MAX_CONCURRENCY=6
LUNA_TIMEOUT_SECONDS=30
LUNA_MAX_RETRIES=2
LUNA_REASONING_EFFORT=               # 空=送らない | low | medium | high
# 推論モデルは思考を completion 予算から払う。gpt-5.6-luna の実測(seed 11)では
# completion の70%が思考で、半数の呼び出しがJSONの途中で切れた。gpt-6-luna で
# 同じ条件の基準線を取り直し、まだ切れるなら low を試す。非対応のエンドポイントは
# 最初の400で学習し、以後は送らない。

# --- Reasoning engine ---
WEREWOLF_REASONING_ENGINE=v3         # legacy | v2 | v3
# v3     : (既定) コードは事実台帳・論理ソルバー・検証・発言順だけを担当し、誰を
#          疑うか・投票・夜行動はモデルが「盤面メモ」を読んで決める。発言はチャット調で
#          定型文を挿入しない。経緯は docs/approach-reset-2026-10.md を参照。
# v2     : 投票・夜行動・発言順はコードが決定論的に決め、モデルは言い回しだけを担当。
#          比較用に残してあり、保守のみ。詳細は docs/architecture.md を参照。
# legacy : 投票・夜行動・発言内容のすべてをモデルの出力に任せる、以前の方式

# --- Backend ---
WEREWOLF_ENV=development
WEREWOLF_CORS_ORIGINS=http://localhost:5173
WEREWOLF_LOG_LEVEL=INFO
WEREWOLF_SESSION_STORE=memory
WEREWOLF_RNG_SEED=
WEREWOLF_ACCESS_PASSWORD=              # 公開デプロイでは長いランダム値を設定
