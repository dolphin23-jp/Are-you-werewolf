# Template only -- copy to `backend/.env` and fill in real values there.
# `.env` is gitignored; THIS file is committed to a PUBLIC repository, so
# never put a real API key in it.
#
# コメントは必ず値とは別の行に書くこと(`KEY=値  # コメント` の形にしない)。
# `docker run --env-file backend/.env` は行末のコメントと空白も値の一部として渡すため、
# 空のつもりの値がコメントの文字列になる。WEREWOLF_ACCESS_PASSWORD だけは「空白のあとの #」で
# 始まる値を空として扱うが、`KEY=#...` のような形や他の設定は守られないので、コメントは別の行に書く。
#
# --- LLM Provider ---
# mock | scenario | anthropic | luna のどれか。
# mock      : 9つの定型文を返す最小のテストダブル(既定・オフライン・費用ゼロ)
# scenario  : 返信/引用・名指し質問・論点・処刑候補まで構造を埋めるテストダブル
#             (オフライン・費用ゼロ。指標を縮退させずに前後比較したいときに使う)
# anthropic : 実際の Claude API(要 WEREWOLF_ANTHROPIC_API_KEY / 課金あり)。
#             "claude" やモデル名(claude-opus-5-5 など)を書いても anthropic 扱い。
#             モデル名を書いた場合、WEREWOLF_ANTHROPIC_MODEL が未設定ならそのモデルを使い、
#             別のモデル名が設定されていれば起動時にエラーで止まる。このファイルをコピーした
#             .env には WEREWOLF_ANTHROPIC_MODEL の行があるので、モデルはその行で変える。
# luna      : 代替。OpenAI互換の gpt-6-luna(要 LUNA_API_KEY / 課金あり)。休止中だが選択可。
# テストは常に mock で走る。CI に実プロバイダを設定しないこと。
WEREWOLF_LLM_PROVIDER=mock

# --- Anthropic (Claude) ---
# 名前はわざと WEREWOLF_ 接頭辞付き。SDK 標準の ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL は
# 同じマシンの別ツールが設定していることが多く、それを拾うと別アカウントに課金されたり、
# 役職を含むプロンプトが意図しない宛先に送られたりする。プロバイダはキーと URL を
# 常に明示的に SDK に渡し、ANTHROPIC_* は一切読まない。
WEREWOLF_ANTHROPIC_API_KEY=
WEREWOLF_ANTHROPIC_BASE_URL=https://api.anthropic.com
# 既定は Claude Sonnet 5.5(2026-11-16 のオーナー判断。docs/approach-reset-2026-10.md §11.8)。
# Opus にするなら claude-opus-5-5。
WEREWOLF_ANTHROPIC_MODEL=claude-sonnet-5-5
# プロセス全体で共有する同時リクエスト数の上限(ゲームごとではない。レート制限はキー単位)
WEREWOLF_ANTHROPIC_MAX_CONCURRENCY=8
WEREWOLF_ANTHROPIC_TIMEOUT_SECONDS=120
# 一時的な失敗(接続/タイムアウト/429/5xx/529)だけを再試行する回数。拒否と切断は再試行しない
WEREWOLF_ANTHROPIC_MAX_RETRIES=2
# 毎リクエストの max_tokens の下限。Sonnet 5.5 も Opus 5.5 も必要に応じて思考し、思考も同じ予算から払うため、
# 小さい値だと JSON の途中で切れる。課金は実際に出たトークン分だけなので、上限を高くしても
# それ自体の費用は増えない。
WEREWOLF_ANTHROPIC_MAX_TOKENS=12000
# 呼び出し種別ごとの思考の深さ: low | medium | high | xhigh | max (空=既定値)
WEREWOLF_ANTHROPIC_EFFORT_DISCUSSION=low
WEREWOLF_ANTHROPIC_EFFORT_VOTE=medium
WEREWOLF_ANTHROPIC_EFFORT_NIGHT=medium
WEREWOLF_ANTHROPIC_EFFORT_CHAT=low
WEREWOLF_ANTHROPIC_EFFORT_DEFAULT=medium
# default: 拒否されたターンをサーバー側で代替モデルが引き継ぐ(beta) | off: 拒否はそのまま失敗
WEREWOLF_ANTHROPIC_FALLBACKS=default
# 人間がプレイする1セッションあたりの推定費用の上限(USD)
WEREWOLF_SESSION_MAX_COST_USD=30
# 課金のあるプロバイダ(anthropic・luna)で WEREWOLF_ACCESS_PASSWORD が空のまま起動するには true が必要。
# 誰でも課金できる状態になるため、意図した場合以外は false のままにする。
WEREWOLF_ALLOW_OPEN_ACCESS=false

# --- luna (alternative, dormant): gpt-6-luna via OpenAI-compatible API ---
# NOTE: LUNA_* names/values are placeholders pending the real gpt-6-luna
# endpoint details (base URL / auth scheme). Rename freely once known.
LUNA_API_KEY=
LUNA_BASE_URL=https://api.example.com/v1
LUNA_MODEL=gpt-6-luna
LUNA_MAX_CONCURRENCY=6
LUNA_TIMEOUT_SECONDS=30
LUNA_MAX_RETRIES=2
# 空=送らない | low | medium | high
# 推論モデルは思考を completion 予算から払う。gpt-5.6-luna の実測(seed 11)では
# completion の70%が思考で、半数の呼び出しがJSONの途中で切れた。gpt-6-luna で
# 同じ条件の基準線を取り直し、まだ切れるなら low を試す。非対応のエンドポイントは
# 最初の400で学習し、以後は送らない。
LUNA_REASONING_EFFORT=

# --- Reasoning engine ---
# legacy | v2 | v3 のどれか。
# v3     : (既定) コードは事実台帳・論理ソルバー・検証・発言順だけを担当し、誰を
#          疑うか・投票・夜行動はモデルが「盤面メモ」を読んで決める。発言はチャット調で
#          定型文を挿入しない。経緯は docs/approach-reset-2026-10.md を参照。
# v2     : 投票・夜行動・発言順はコードが決定論的に決め、モデルは言い回しだけを担当。
#          比較用に残してあり、保守のみ。詳細は docs/architecture.md を参照。
# legacy : 投票・夜行動・発言内容のすべてをモデルの出力に任せる、以前の方式
WEREWOLF_REASONING_ENGINE=v3

# --- Backend ---
WEREWOLF_ENV=development
WEREWOLF_CORS_ORIGINS=http://localhost:5173
WEREWOLF_LOG_LEVEL=INFO
WEREWOLF_SESSION_STORE=memory
WEREWOLF_RNG_SEED=
# 公開デプロイでは長いランダム値を設定する。課金のあるプロバイダ(anthropic・luna)で空のままだと起動しない
# (自分だけが使うローカル環境に限り WEREWOLF_ALLOW_OPEN_ACCESS=true で外せる)。
WEREWOLF_ACCESS_PASSWORD=
